<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starweave.mapper.SponsorMapper">

    <resultMap id="BaseMap" type="Sponsor">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="display_name" property="displayName"/>
        <result column="message" property="message"/>
        <result column="border_style" property="borderStyle"/>
        <result column="amount" property="amount"/>
        <result column="platform" property="platform"/>
        <result column="is_active" property="isActive"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findById" resultMap="BaseMap">
        SELECT * FROM sponsor WHERE id = #{id}
    </select>

    <select id="findActive" resultMap="BaseMap">
        SELECT * FROM sponsor WHERE is_active = 1 ORDER BY amount DESC, created_at ASC
    </select>

    <select id="findByUserId" resultMap="BaseMap">
        SELECT * FROM sponsor WHERE user_id = #{userId} ORDER BY created_at DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sponsor (user_id, display_name, message, border_style, amount, platform, is_active)
        VALUES (#{userId}, #{displayName}, #{message}, #{borderStyle}, #{amount}, #{platform}, 1)
    </insert>

    <update id="deactivate">
        UPDATE sponsor SET is_active = 0 WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sponsor WHERE id = #{id}
    </delete>

    <select id="countActive" resultType="long">
        SELECT COUNT(*) FROM sponsor WHERE is_active = 1
    </select>
</mapper>
